# ============================================
# Variables de entorno - TEMPLATE
# Copia este archivo a .env y llena con tus valores reales:
#   cp .env.example .env
# ============================================

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contrasena_mysql
DB_NAME=events_db

# --- Servidor ---
PORT=3000

# --- Sesion (genera una cadena aleatoria larga para produccion) ---
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga
