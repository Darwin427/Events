<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/asistente-header', {
        session: session,
        headerSubtitle: 'Eventos disponibles',
        mensaje: mensaje
    }) %>

    <main class="pb-main">
        <div style="margin-bottom: 24px;">
            <h1 style="margin: 0;">Eventos disponibles</h1>
            <p style="color: var(--neutral-500); margin: 4px 0 0;">
                <%= eventos.length %> <%= eventos.length === 1 ? 'evento programado' : 'eventos programados' %>
            </p>
        </div>

        <% if (eventos.length === 0) { %>
            <div class="pb-card pb-card-padded" style="text-align: center; padding: 56px 32px;">
                <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--brand-accent-soft); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B2A4E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                    </svg>
                </div>
                <h3 style="margin: 0 0 8px;">No hay eventos disponibles</h3>
                <p style="color: var(--neutral-500); max-width: 460px; margin: 0 auto;">
                    Vuelve mas tarde. En cuanto el administrador apruebe nuevas propuestas, apareceran aqui.
                </p>
            </div>
        <% } else { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px;">
                <% eventos.forEach(function(e) { %>
                    <article class="pb-card" style="display: flex; flex-direction: column;">
                        <div style="padding: 18px 22px; flex: 1; display: flex; flex-direction: column; gap: 12px;">
                            <div>
                                <div style="font-size: 17px; font-weight: 600; color: var(--brand-primary); line-height: 1.3;">
                                    <%= e.Tema %>
                                </div>
                                <div style="font-size: 13px; color: var(--neutral-500); margin-top: 4px;">
                                    <%= e.NombrePonente %><% if (e.NombreEmpresa) { %> · <%= e.NombreEmpresa %><% } %>
                                </div>
                            </div>

                            <p style="font-size: 14px; color: var(--neutral-700); margin: 0; line-height: 1.5;">
                                <%= e.IdeaPrincipal.length > 140 ? e.IdeaPrincipal.substring(0, 140) + '...' : e.IdeaPrincipal %>
                            </p>

                            <div style="background: var(--neutral-100); border-radius: var(--radius-md); padding: 12px 14px; font-size: 13px;">
                                <div style="display: flex; gap: 6px; margin-bottom: 6px;">
                                    <span style="color: var(--neutral-500);">📅</span>
                                    <strong><%= e.FechaDefinitivaFmt %></strong>
                                </div>
                                <div style="display: flex; gap: 6px; margin-bottom: 6px;">
                                    <span style="color: var(--neutral-500);">🕐</span>
                                    <strong><%= e.HoraInicioFmt %> — <%= e.HoraFinFmt %></strong>
                                </div>
                                <div style="display: flex; gap: 6px;">
                                    <span style="color: var(--neutral-500);">📍</span>
                                    <strong><%= e.Lugar %></strong>
                                </div>
                            </div>

                            <!-- Cupo + barra de progreso -->
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
                                    <span style="font-size: 12px; color: var(--neutral-500); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Cupo</span>
                                    <span style="font-size: 13px; font-weight: 600; color: <%= e.lleno ? 'var(--state-danger)' : 'var(--neutral-700)' %>;">
                                        <%= e.Inscritos %> / <%= e.CupoMaximo %>
                                    </span>
                                </div>
                                <div style="height: 6px; background: var(--neutral-200); border-radius: var(--radius-pill); overflow: hidden;">
                                    <% const pct = Math.min(100, Math.round((e.Inscritos / e.CupoMaximo) * 100)); %>
                                    <div style="height: 100%; width: <%= pct %>%; background: <%= e.lleno ? 'var(--state-danger)' : pct > 80 ? 'var(--state-warning)' : 'var(--state-success)' %>; transition: width 0.3s ease;"></div>
                                </div>
                            </div>

                            <!-- Accion -->
                            <div style="margin-top: auto; padding-top: 8px;">
                                <% if (e.yaInscrito) { %>
                                    <div class="pb-alert pb-alert-success" style="margin: 0;">
                                        <span>✓</span>
                                        <span>Ya estas inscrito</span>
                                    </div>
                                <% } else if (e.inscripcionCancelada) { %>
                                    <div class="pb-alert pb-alert-danger" style="margin: 0;">
                                        <span>⚠️</span>
                                        <span>Cancelaste tu inscripcion previamente</span>
                                    </div>
                                <% } else if (e.lleno) { %>
                                    <button type="button" class="pb-btn pb-btn-ghost pb-btn-full" disabled>Cupo lleno</button>
                                <% } else { %>
                                    <form action="/asistente/eventos/<%= e.IdEvento %>/inscribirse"
                                          method="POST"
                                          style="margin: 0;"
                                          onsubmit="return confirm('¿Confirmas tu inscripcion a este evento?');">
                                        <button type="submit" class="pb-btn pb-btn-primary pb-btn-full">
                                            Inscribirme
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </div>
        <% } %>
    </main>
</body>
</html>
