<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="pb-login-bg">
        <div class="pb-login-card">
            <div class="pb-header">
                <div class="pb-header-brand">
                    <div class="pb-logo-mark">PB</div>
                    <div>
                        <div class="pb-logo-text">INSTITUCION UNIVERSITARIA</div>
                        <div class="pb-logo-name">PASCUAL BRAVO</div>
                    </div>
                </div>
            </div>
            <div class="pb-strip"></div>

            <div class="pb-login-body">
                <h2 class="pb-login-title">Portal del Asistente</h2>
                <p class="pb-login-sub">Ingresa con tu correo y contrasena.</p>

                <% if (error) { %>
                    <div class="pb-alert pb-alert-danger">
                        <span>⚠️</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form action="/asistente/login" method="POST" novalidate>
                    <div class="pb-field">
                        <label for="email" class="pb-label">Correo</label>
                        <input type="email" id="email" name="email"
                               class="pb-input" placeholder="asistente@correo.com"
                               autocomplete="email" required>
                    </div>

                    <div class="pb-field">
                        <label for="password" class="pb-label">Contrasena</label>
                        <input type="password" id="password" name="password"
                               class="pb-input" placeholder="••••••••"
                               autocomplete="current-password" required>
                    </div>

                    <button type="submit" class="pb-btn pb-btn-primary pb-btn-full">
                        Iniciar sesion
                    </button>
                </form>

                <div class="pb-login-footer">
                    ¿No tienes cuenta? <a href="/asistente/registro">Crear cuenta</a>
                    <br>
                    <a href="/inicio" style="font-size: 12px;">← Volver al inicio</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
