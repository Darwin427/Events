<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/Modelo.css">
</head>
<body>
    <aside class="sidebar">
        <nav>
            <ul>
                <li>
                    <a href="/asistente/calendar">
