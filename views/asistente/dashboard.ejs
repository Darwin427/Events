<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/asistente-header', {
        session: session,
        headerSubtitle: 'Mi panel',
        mensaje: typeof mensaje !== 'undefined' ? mensaje : null
    }) %>

    <main class="pb-main">
        <!-- Encabezado de seccion + estadisticas -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
            <div>
                <h1 style="margin: 0;">Mis inscripciones</h1>
                <p style="color: var(--neutral-500); margin: 4px 0 0;">
                    <%= stats.total %> <%= stats.total === 1 ? 'inscripcion activa' : 'inscripciones activas' %>
                </p>
            </div>
            <a href="/asistente/eventos" class="pb-btn pb-btn-accent" style="text-decoration: none;">
                + Explorar eventos
            </a>
        </div>

        <!-- Mini estadisticas -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 28px;">
            <div class="pb-card pb-card-padded" style="text-align: center;">
                <div style="font-size: 32px; font-weight: 700; color: var(--brand-primary);"><%= stats.total %></div>
                <div style="color: var(--neutral-500); font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Total</div>
            </div>
            <div class="pb-card pb-card-padded" style="text-align: center;">
                <div style="font-size: 32px; font-weight: 700; color: var(--state-success);"><%= stats.proximas %></div>
                <div style="color: var(--neutral-500); font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Proximas</div>
            </div>
            <div class="pb-card pb-card-padded" style="text-align: center;">
                <div style="font-size: 32px; font-weight: 700; color: var(--neutral-500);"><%= stats.pasadas %></div>
                <div style="color: var(--neutral-500); font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Asistidas</div>
            </div>
        </div>

        <!-- Listado de inscripciones -->
        <% if (inscripciones.length === 0) { %>
            <div class="pb-card pb-card-padded" style="text-align: center; padding: 56px 32px;">
                <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--brand-accent-soft); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B2A4E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                </div>
                <h3 style="margin: 0 0 8px;">Aun no tienes inscripciones</h3>
                <p style="color: var(--neutral-500); max-width: 460px; margin: 0 auto 24px;">
                    Explora los eventos disponibles y elige los que mas te interesen.
                </p>
                <a href="/asistente/eventos" class="pb-btn pb-btn-accent" style="text-decoration: none;">+ Ver eventos disponibles</a>
            </div>
        <% } else { %>
            <% inscripciones.forEach(function(i) { %>
                <div class="pb-card" style="margin-bottom: 16px; <%= i.esPasada ? 'opacity: 0.7;' : '' %>">
                    <div style="padding: 18px 22px;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; gap: 12px; flex-wrap: wrap;">
                            <div style="min-width: 0; flex: 1;">
                                <div style="font-size: 17px; font-weight: 600; color: var(--brand-primary); margin-bottom: 2px;">
                                    <%= i.Tema %>
                                </div>
                                <div style="font-size: 13px; color: var(--neutral-500);">
                                    Ponente: <%= i.NombrePonente %>
                                    <% if (i.NombreEmpresa) { %> · <%= i.NombreEmpresa %><% } %>
                                </div>
                            </div>
                            <% if (i.esPasada) { %>
                                <span class="pb-pill" style="background: var(--neutral-200); color: var(--neutral-700);">Asistida</span>
                            <% } else { %>
                                <span class="pb-pill pb-pill-approved">Proxima</span>
                            <% } %>
                        </div>

                        <div style="background: var(--neutral-100); border-radius: var(--radius-md); padding: 14px 16px; margin-bottom: 14px;">
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px 24px; font-size: 13px;">
                                <div>
                                    <span style="color: var(--neutral-500);">Fecha:</span>
                                    <strong><%= i.FechaDefinitivaFmt %></strong>
                                </div>
                                <div>
                                    <span style="color: var(--neutral-500);">Hora:</span>
                                    <strong><%= i.HoraInicioFmt %> — <%= i.HoraFinFmt %></strong>
                                </div>
                                <div>
                                    <span style="color: var(--neutral-500);">Lugar:</span>
                                    <strong><%= i.Lugar %></strong>
                                </div>
                            </div>
                        </div>

                        <% if (!i.esPasada) { %>
                            <form action="/asistente/inscripciones/<%= i.IdInscripcion %>/cancelar"
                                  method="POST"
                                  style="margin: 0;"
                                  onsubmit="return confirm('¿Seguro que quieres cancelar tu inscripcion a este evento?');">
                                <button type="submit" class="pb-btn pb-btn-danger">Cancelar inscripcion</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </main>
</body>
</html>
