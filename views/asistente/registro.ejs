<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="pb-login-bg">
        <div class="pb-login-card" style="max-width: 460px;">
            <div class="pb-header">
                <div class="pb-header-brand">
                    <div class="pb-logo-mark">PB</div>
                    <div>
                        <div class="pb-logo-text">INSTITUCION UNIVERSITARIA</div>
                        <div class="pb-logo-name">PASCUAL BRAVO</div>
                    </div>
                </div>
            </div>
            <div class="pb-strip"></div>

            <div class="pb-login-body">
                <h2 class="pb-login-title">Crear cuenta de Asistente</h2>
                <p class="pb-login-sub">Tu cuenta queda activa inmediatamente, sin esperar aprobacion.</p>

                <% if (error) { %>
                    <div class="pb-alert pb-alert-danger">
                        <span>⚠️</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <% if (success) { %>
                    <div class="pb-alert pb-alert-success">
                        <span>✓</span>
                        <span><%= success %></span>
                    </div>
                    <div style="text-align: center; margin-top: 16px;">
                        <a href="/asistente/login" class="pb-btn pb-btn-primary pb-btn-full" style="text-decoration: none; display: inline-block;">Ir a iniciar sesion</a>
                    </div>
                <% } else { %>
                    <form action="/asistente/registro" method="POST" novalidate>
                        <div class="pb-field">
                            <label for="nombre" class="pb-label">Nombre completo</label>
                            <input type="text" id="nombre" name="nombre"
                                   class="pb-input" placeholder="Juan Perez"
                                   value="<%= form.nombre || '' %>"
                                   minlength="3" maxlength="100"
                                   autocomplete="name" required>
                        </div>

                        <div class="pb-field">
                            <label for="email" class="pb-label">Correo electronico</label>
                            <input type="email" id="email" name="email"
                                   class="pb-input" placeholder="tu@correo.com"
                                   value="<%= form.email || '' %>"
                                   maxlength="150"
                                   autocomplete="email" required>
                        </div>

                        <div class="pb-field">
                            <label for="password" class="pb-label">Contrasena</label>
                            <input type="password" id="password" name="password"
                                   class="pb-input" placeholder="Minimo 8 caracteres"
                                   minlength="8"
                                   autocomplete="new-password" required>
                            <small style="color: var(--neutral-500); font-size: 12px;">Al menos 8 caracteres.</small>
                        </div>

                        <div class="pb-field">
                            <label for="passwordConfirm" class="pb-label">Confirmar contrasena</label>
                            <input type="password" id="passwordConfirm" name="passwordConfirm"
                                   class="pb-input" placeholder="Repite tu contrasena"
                                   minlength="8"
                                   autocomplete="new-password" required>
                        </div>

                        <button type="submit" class="pb-btn pb-btn-primary pb-btn-full">
                            Crear cuenta
                        </button>
                    </form>
                <% } %>

                <div class="pb-login-footer">
                    ¿Ya tienes cuenta? <a href="/asistente/login">Iniciar sesion</a>
                    <br>
                    <a href="/inicio" style="font-size: 12px;">← Volver al inicio</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
