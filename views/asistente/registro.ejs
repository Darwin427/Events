<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <div class="pb-login-bg" style="background: linear-gradient(135deg, rgba(27, 42, 78, 0.92), rgba(36, 55, 96, 0.94));">
        <div class="pb-login-card" style="max-width: 460px;">
            <div class="pb-header">
                <div class="pb-header-brand">
                    <div class="pb-logo-mark">PB</div>
                    <div>
                        <div class="pb-logo-text">INSTITUCIÓN UNIVERSITARIA</div>
                        <div class="pb-logo-name">PASCUAL BRAVO</div>
                    </div>
                </div>
            </div>
            <div class="pb-strip"></div>

            <div class="pb-login-body">
                <h2 class="pb-login-title">Crear cuenta de asistente</h2>
                <p class="pb-login-sub">Completa el formulario para empezar a inscribirte a eventos.</p>

                <% if (error) { %>
                    <div class="pb-alert pb-alert-danger">
                        <span>⚠️</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <% if (success) { %>
                    <div class="pb-alert" style="background: var(--state-success-soft); color: #1B5E20; border-left: 3px solid var(--state-success);">
                        <span>✓</span>
                        <span><%= success %></span>
                    </div>
                    <div style="text-align: center; margin-top: 20px;">
                        <a href="/asistente/login" class="pb-btn pb-btn-primary" style="text-decoration: none;">Iniciar sesión</a>
                    </div>
                <% } else { %>
                    <form action="/asistente/registro" method="POST" novalidate>
                        <div class="pb-field">
                            <label for="nombre" class="pb-label">Nombre completo *</label>
                            <input type="text" id="nombre" name="nombre" class="pb-input" required
                                   value="<%= form.nombre || '' %>" placeholder="Tu nombre y apellido" maxlength="100">
                        </div>

                        <div class="pb-field">
                            <label for="email" class="pb-label">Correo *</label>
                            <input type="email" id="email" name="email" class="pb-input" required
                                   value="<%= form.email || '' %>" placeholder="tu.correo@ejemplo.com" maxlength="150">
                        </div>

                        <div class="pb-field">
                            <label for="password" class="pb-label">Contraseña * (mínimo 8 caracteres)</label>
                            <input type="password" id="password" name="password" class="pb-input" required minlength="8" placeholder="••••••••">
                        </div>

                        <div class="pb-field">
                            <label for="passwordConfirm" class="pb-label">Confirmar contraseña *</label>
                            <input type="password" id="passwordConfirm" name="passwordConfirm" class="pb-input" required minlength="8" placeholder="••••••••">
                        </div>

                        <button type="submit" class="pb-btn pb-btn-primary pb-btn-full">
                            Crear cuenta
                        </button>
                    </form>
                <% } %>

                <div class="pb-login-footer">
                    ¿Ya tienes cuenta? <a href="/asistente/login">Iniciar sesión</a>
                    <br>
                    <a href="/inicio" style="font-size: 12px;">← Volver al inicio</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
