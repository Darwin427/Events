<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/Modelo.css">
</head>
<body>
    <div class="pb-login-bg">
        <div class="pb-login-card">
            <div class="pb-header">
                <div class="pb-header-brand">
                    <div class="pb-logo-mark">PB</div>
                    <div>
                        <div class="pb-logo-text">INSTITUCIÓN UNIVERSITARIA</div>
                        <div class="pb-logo-name">PASCUAL BRAVO</div>
                    </div>
                </div>
            </div>
            <div class="pb-strip"></div>

            <div class="pb-login-body">
                <h2 class="pb-login-title">Portal del Ponente</h2>
                <p class="pb-login-sub">Ingresa con tus credenciales asignadas.</p>

                <% if (error) { %>
                    <div class="pb-alert pb-alert-danger">
                        <span>⚠️</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form action="/ponente/login" method="POST" novalidate>
                    <div class="pb-field">
                        <label for="email" class="pb-label">Correo</label>
                        <input type="email" id="email" name="email"
                               class="pb-input" placeholder="ponente@correo.com" required>
                    </div>

                    <div class="pb-field">
                        <label for="password" class="pb-label">Contraseña</label>
                        <input type="password" id="password" name="password"
                               class="pb-input" placeholder="••••••••" required>
                    </div>

                    <button type="submit" class="pb-btn pb-btn-primary pb-btn-full">
                        Iniciar sesión
                    </button>
                </form>

                <div class="pb-login-footer">
                    ¿No tienes cuenta? <a href="/ponente/registro">Solicitar acceso</a>
                    <br>
                    <a href="/inicio" style="font-size: 12px;">← Volver al inicio</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
