<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/ponente-header', { session: session, headerSubtitle: 'Mis propuestas' }) %>

    <main class="pb-main">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
            <div>
                <h1 style="margin: 0;">Mis propuestas</h1>
                <p style="color: var(--neutral-500); margin: 4px 0 0;">
                    <%= propuestas.length %> <%= propuestas.length === 1 ? 'propuesta' : 'propuestas' %> en total
                </p>
            </div>
            <a href="/ponente/propuestas/nueva" class="pb-btn pb-btn-accent" style="text-decoration: none;">+ Nueva propuesta</a>
        </div>

        <% if (propuestas.length === 0) { %>
            <div class="pb-card pb-card-padded" style="text-align: center; padding: 56px 32px;">
                <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--brand-accent-soft); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B2A4E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <path d="M14 2v6h6M12 18v-6M9 15h6"/>
                    </svg>
                </div>
                <h3 style="margin: 0 0 8px;">Aún no tienes propuestas</h3>
                <p style="color: var(--neutral-500); max-width: 460px; margin: 0 auto 24px;">
                    Crea tu primera propuesta para empezar a participar en los eventos de la institución.
                </p>
                <a href="/ponente/propuestas/nueva" class="pb-btn pb-btn-accent" style="text-decoration: none;">+ Crear primera propuesta</a>
            </div>
        <% } else { %>
            <% propuestas.forEach(function(p) { %>
                <% const stateClass = 'pb-card-status-' + (p.Estado === 'pendiente' ? 'pending' : p.Estado === 'aprobada' ? 'approved' : p.Estado === 'rechazada' ? 'rejected' : 'cancelled'); %>
                <% const pillClass = 'pb-pill-' + (p.Estado === 'pendiente' ? 'pending' : p.Estado === 'aprobada' ? 'approved' : p.Estado === 'rechazada' ? 'rejected' : 'cancelled'); %>
                <div class="pb-card <%= stateClass %>" style="margin-bottom: 16px;">
                    <div style="padding: 18px 22px;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; gap: 12px; flex-wrap: wrap;">
                            <div>
                                <div style="font-size: 17px; font-weight: 600; color: var(--brand-primary); margin-bottom: 2px;"><%= p.Tema %></div>
                                <div style="font-size: 13px; color: var(--neutral-500);">
                                    <%= p.NombreEmpresa ? p.NombreEmpresa : 'Universidad Pascual Bravo (interno)' %>
                                </div>
                            </div>
                            <span class="pb-pill <%= pillClass %>"><%= p.Estado %></span>
                        </div>

                        <% if (p.Estado === 'aprobada' && p.FechaDefinitiva) { %>
                            <div style="background: var(--neutral-100); border-radius: var(--radius-md); padding: 14px 16px; margin-top: 4px;">
                                <div style="font-size: 11px; letter-spacing: 0.6px; text-transform: uppercase; color: var(--neutral-700); font-weight: 600; margin-bottom: 8px;">Detalles del evento</div>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px 24px; font-size: 13px;">
                                    <div><span style="color: var(--neutral-500);">Fecha:</span> <strong><%= formatDate(p.FechaDefinitiva) %></strong></div>
                                    <div><span style="color: var(--neutral-500);">Hora:</span> <strong><%= p.HoraInicio %> — <%= p.HoraFin %></strong></div>
                                    <div><span style="color: var(--neutral-500);">Lugar:</span> <strong><%= p.Lugar %></strong></div>
                                    <div><span style="color: var(--neutral-500);">Cupo:</span> <strong><%= p.CupoMaximo %> personas</strong></div>
                                </div>
                            </div>
                        <% } else if (p.Estado === 'rechazada' && p.MotivoRechazo) { %>
                            <div class="pb-alert pb-alert-danger" style="margin-top: 4px; margin-bottom: 0;">
                                <span><strong>Motivo:</strong> <%= p.MotivoRechazo %></span>
                            </div>
                        <% } else { %>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px 24px; padding: 12px 0; border-top: 1px solid var(--neutral-200); font-size: 13px;">
                                <div><span style="color: var(--neutral-500);">Fecha tentativa:</span> <strong><%= formatDate(p.FechaTentativa) %></strong></div>
                                <div><span style="color: var(--neutral-500);">Alcance:</span> <strong><%= p.AlcanceEsperado %> personas</strong></div>
                                <div><span style="color: var(--neutral-500);">Documentos:</span> <strong><%= p.NumDocumentos %> de 3</strong></div>
                                <div><span style="color: var(--neutral-500);">Enviada:</span> <strong><%= formatDate(p.FechaEnvio) %></strong></div>
                            </div>
                        <% } %>

                        <div style="display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap;">
                            <a href="/ponente/propuestas/<%= p.IdPropuesta %>" class="pb-btn pb-btn-ghost" style="text-decoration: none;">Ver detalle</a>
                            <% if (p.Estado === 'pendiente') { %>
                                <a href="/ponente/propuestas/<%= p.IdPropuesta %>/editar" class="pb-btn pb-btn-ghost" style="text-decoration: none;">Editar</a>
                                <form action="/ponente/propuestas/<%= p.IdPropuesta %>/cancelar" method="POST" style="display: inline; margin: 0;" onsubmit="return confirm('¿Seguro que quieres cancelar esta propuesta? No podrá deshacerse.');">
                                    <button type="submit" class="pb-btn pb-btn-danger">Cancelar</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </main>
</body>
</html>
